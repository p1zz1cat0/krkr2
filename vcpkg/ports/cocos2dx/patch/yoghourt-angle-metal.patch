+#if (CC_TARGET_PLATFORM == CC_PLATFORM_MAC)
+bool GLViewImpl::initANGLEMetal()
+{
+    auto getPlatformDisplay = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(
+        eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    if (!getPlatformDisplay)
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: eglGetPlatformDisplayEXT unavailable\n");
+        return false;
+    }
+
+    const EGLint displayAttributes[] = {
+        EGL_PLATFORM_ANGLE_TYPE_ANGLE,
+        EGL_PLATFORM_ANGLE_TYPE_METAL_ANGLE,
+        EGL_NONE
+    };
+    _eglDisplay = getPlatformDisplay(
+        EGL_PLATFORM_ANGLE_ANGLE,
+        nullptr,
+        displayAttributes);
+    if (_eglDisplay == EGL_NO_DISPLAY)
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: ANGLE Metal display unavailable error=0x%x\n",
+                eglGetError());
+        return false;
+    }
+
+    EGLint major = 0;
+    EGLint minor = 0;
+    if (!eglInitialize(_eglDisplay, &major, &minor) || !eglBindAPI(EGL_OPENGL_ES_API))
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: EGL initialize/bind failed error=0x%x\n",
+                eglGetError());
+        return false;
+    }
+
+    const EGLint configAttributes[] = {
+        EGL_SURFACE_TYPE, EGL_WINDOW_BIT | EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8,
+        EGL_GREEN_SIZE, 8,
+        EGL_BLUE_SIZE, 8,
+        EGL_ALPHA_SIZE, 8,
+        EGL_DEPTH_SIZE, 24,
+        EGL_STENCIL_SIZE, 8,
+        EGL_NONE
+    };
+    EGLint configCount = 0;
+    if (!eglChooseConfig(_eglDisplay, configAttributes, &_eglConfig, 1, &configCount)
+        || configCount != 1)
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: no EGL config error=0x%x\n",
+                eglGetError());
+        return false;
+    }
+
+    const EGLint contextAttributes[] = {
+        EGL_CONTEXT_CLIENT_VERSION, 2,
+        EGL_NONE
+    };
+    _eglContext = eglCreateContext(
+        _eglDisplay,
+        _eglConfig,
+        EGL_NO_CONTEXT,
+        contextAttributes);
+    if (_eglContext == EGL_NO_CONTEXT)
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: EGL context error=0x%x\n",
+                eglGetError());
+        return false;
+    }
+
+    NSWindow* cocoaWindow = glfwGetCocoaWindow(_mainWindow);
+    NSView* contentView = cocoaWindow.contentView;
+    if (!contentView)
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: GLFW Cocoa content view unavailable\n");
+        return false;
+    }
+    contentView.wantsLayer = YES;
+    [contentView layoutSubtreeIfNeeded];
+    CALayer* backingLayer = contentView.layer;
+    if (!backingLayer)
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: AppKit backing CALayer unavailable\n");
+        return false;
+    }
+
+    _eglSurface = eglCreateWindowSurface(
+        _eglDisplay,
+        _eglConfig,
+        (EGLNativeWindowType)(__bridge void*)backingLayer,
+        nullptr);
+    if (_eglSurface == EGL_NO_SURFACE
+        || !eglMakeCurrent(_eglDisplay, _eglSurface, _eglSurface, _eglContext))
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: EGL window surface error=0x%x\n",
+                eglGetError());
+        return false;
+    }
+
+    eglSwapInterval(_eglDisplay, 1);
+    if (!updateANGLESurfaceSize())
+        return false;
+
+    const char* renderer = reinterpret_cast<const char*>(glGetString(GL_RENDERER));
+    const char* version = reinterpret_cast<const char*>(glGetString(GL_VERSION));
+    const bool isANGLEMetal = renderer
+        && std::strstr(renderer, "ANGLE")
+        && std::strstr(renderer, "Metal");
+    if (!isANGLEMetal)
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer initialization failed: expected ANGLE Metal, got %s\n",
+                renderer ? renderer : "(null)");
+        return false;
+    }
+
+    EGLint surfaceWidth = 0;
+    EGLint surfaceHeight = 0;
+    eglQuerySurface(_eglDisplay, _eglSurface, EGL_WIDTH, &surfaceWidth);
+    eglQuerySurface(_eglDisplay, _eglSurface, EGL_HEIGHT, &surfaceHeight);
+    const CGFloat backingScale = cocoaWindow.backingScaleFactor;
+    fprintf(stdout,
+            "[Yoghourt] RENDERER backend=angle-metal egl=%d.%d gles=\"%s\" renderer=\"%s\" surface=%dx%d scale=%.2f\n",
+            major, minor, version ? version : "unknown", renderer,
+            surfaceWidth, surfaceHeight, backingScale);
+    fflush(stdout);
+    return true;
+}
+
+bool GLViewImpl::updateANGLESurfaceSize()
+{
+    if (_eglDisplay == EGL_NO_DISPLAY || _eglSurface == EGL_NO_SURFACE)
+        return false;
+
+    EGLint surfaceWidth = 0;
+    EGLint surfaceHeight = 0;
+    if (!eglQuerySurface(_eglDisplay, _eglSurface, EGL_WIDTH, &surfaceWidth)
+        || !eglQuerySurface(_eglDisplay, _eglSurface, EGL_HEIGHT, &surfaceHeight))
+    {
+        fprintf(stderr, "[Yoghourt] ERROR renderer surface query failed error=0x%x\n", eglGetError());
+        _eglDrawable = false;
+        return false;
+    }
+
+    _eglDrawable = surfaceWidth > 0 && surfaceHeight > 0;
+    if (!_eglDrawable)
+        return true;
+
+
+    // ANGLE's EGL surface does not follow live window resizes on macOS: it
+    // keeps reporting the size it was created with, while the CAMetalLayer
+    // drawable does resize. updateMousePosition() converts the cursor into
+    // real backing pixels, so the frame size has to come from the framebuffer
+    // as well. Trusting eglQuerySurface here leaves _screenSize frozen at the
+    // creation size and collapses the usable hit area into the top-left
+    // corner after every resize.
+    int framebufferWidth = 0;
+    int framebufferHeight = 0;
+    glfwGetFramebufferSize(_mainWindow, &framebufferWidth, &framebufferHeight);
+    if (framebufferWidth > 0 && framebufferHeight > 0)
+    {
+        surfaceWidth = static_cast<EGLint>(framebufferWidth);
+        surfaceHeight = static_cast<EGLint>(framebufferHeight);
+    }
+    int windowWidth = 0;
+    int windowHeight = 0;
+    glfwGetWindowSize(_mainWindow, &windowWidth, &windowHeight);
+    _isInRetinaMonitor = windowWidth > 0 && windowHeight > 0
+        && (surfaceWidth > windowWidth || surfaceHeight > windowHeight);
+    _retinaFactor = 1;
+    const Size previousFrameSize = _screenSize;
+    const bool surfaceSizeChanged = previousFrameSize.width != surfaceWidth
+        || previousFrameSize.height != surfaceHeight;
+    GLView::setFrameSize(static_cast<float>(surfaceWidth), static_cast<float>(surfaceHeight));
+    if (surfaceSizeChanged && _resolutionPolicy != ResolutionPolicy::UNKNOWN)
+    {
+        const Size designSize = _designResolutionSize;
+        const ResolutionPolicy policy = _resolutionPolicy;
+        setDesignResolutionSize(designSize.width, designSize.height, policy);
+        auto director = Director::getInstance();
+        if (director->getOpenGLView() == this)
+            director->setViewport();
+    }
+    return true;
+}
+
+void GLViewImpl::destroyANGLEMetal()
+{
+    if (_eglDisplay == EGL_NO_DISPLAY)
+        return;
+
+    eglMakeCurrent(_eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (_eglSurface != EGL_NO_SURFACE)
+        eglDestroySurface(_eglDisplay, _eglSurface);
+    if (_eglContext != EGL_NO_CONTEXT)
+        eglDestroyContext(_eglDisplay, _eglContext);
+    eglTerminate(_eglDisplay);
+    _eglSurface = EGL_NO_SURFACE;
+    _eglContext = EGL_NO_CONTEXT;
+    _eglDisplay = EGL_NO_DISPLAY;
+    _eglConfig = nullptr;
+    _eglDrawable = false;
+}
