Scripts.execStorage("../common/plugin_assert.tjs");
Plugins.link("TextRender.dll");
var window = new Window();
var layer = new Layer(window, null);
var renderer = new TextRenderBase();
renderer.setDefault(%["fontSize" => 30]);
renderer.setRenderSize(1280, 720);
renderer.bold = true;
renderer.italic = true;
renderer.chColor = 0x123456;
renderer.pitch = 3;
renderer.render("A%135;B%;C", 0, 0, 1, false);
renderer.done();
var characters = renderer.getCharacters(0, 0);
pluginAssertEqual("character count", 3, characters.count);
pluginAssertEqual("initial size", 30, characters[0].size);
pluginAssertEqual("enlarged size", 40, characters[1].size);
pluginAssertEqual("restored size", 30, characters[2].size);
pluginAssertEqual("restored text", "C", characters[2].text);
pluginAssertTrue("bold retained", characters[2].bold);
pluginAssertTrue("italic retained", characters[2].italic);
pluginAssertEqual("color retained", 0x123456, characters[2].color);
pluginAssertEqual("pitch retained", 3, renderer.pitch);
renderer.render("%;%;", 0, 0, 1, false);
pluginAssertEqual("repeated reset", 30, renderer.fontSize);
renderer.defaultFontSize = 22;
renderer.render("%135;D%;E", 0, 0, 1, false);
renderer.done();
characters = renderer.getCharacters(0, 0);
pluginAssertEqual("new default enlarged", 29, characters[3].size);
pluginAssertEqual("new default restored", 22, characters[4].size);
pluginAssertTrue("repeat bold retained", characters[4].bold);
// The original TextRender.dll reads lowercase setDefault keys and centers
// with align/valign = 0. RIDDLE JOKER choice buttons use exactly this call.
var centered = new TextRenderBase();
centered.setDefault(%["fontsize" => 36, "align" => 0, "valign" => 0]);
pluginAssertEqual("lowercase fontsize", 36, centered.defaultFontSize);
pluginAssertEqual("default align", 0, centered.defaultAlign);
pluginAssertEqual("default valign", 0, centered.defaultValign);
centered.setRenderSize(1000, 80);
centered.render("ABCD", 0, 0, 0, false);
centered.done();
characters = centered.getCharacters(0, 0);
var left = characters[0].x;
var right = characters[3].x + characters[3].cw;
pluginAssertEqual("centered size", 36, characters[0].size);
pluginAssertTrue("centered horizontally", left > 0 && (left - (1000 - right)) <= 1 && ((1000 - right) - left) <= 1);
pluginAssertEqual("centered vertically", 22, characters[0].y);
centered.done();
pluginAssertEqual("second done keeps position", left, centered.getCharacters(0, 0)[0].x);
centered.clear();
centered.render("%RAB", 0, 0, 0, false);
centered.done();
characters = centered.getCharacters(0, 0);
pluginAssertEqual("right aligned", 1000, characters[1].x + characters[1].cw);
// Auto-indent rules from textrender.dll (feature 0015, REVERSE section 10).
// A line after LF starts at the indent, so the tests do not need wraps.
var ai = new TextRenderBase();
ai.setDefault(%["fontsize" => 30]);
ai.setRenderSize(1000, 720);
function layout(text, ind) {
    ai.clear();
    ai.render(text, ind, 0, 0, false);
    ai.done();
    return ai.getCharacters(0, 0);
}
characters = layout("「あ\nい", 0);
pluginAssertEqual("autoIndent 0 no indent", 0, characters[2].x);
characters = layout("「あ\nい", 1);
var bracket = characters[0].cw;
pluginAssertTrue("bracket has width", bracket > 0);
pluginAssertEqual("indent after open bracket", bracket, characters[2].x);
characters = layout("「あ\nい", -1);
pluginAssertEqual("first bracket hangs", -bracket, characters[0].x);
pluginAssertEqual("text after hang at margin", 0, characters[1].x);
pluginAssertEqual("hang indent is margin", 0, characters[2].x);
characters = layout("あ「い\nう", -1);
pluginAssertEqual("plain first char no hang", 0, characters[0].x);
pluginAssertEqual("mid-line bracket no indent", 0, characters[3].x);
characters = layout("あ\n「い\nう", 1);
pluginAssertEqual("bracket after LF indents", bracket, characters[3].x);
characters = layout("あ\n「い\nう", -1);
pluginAssertEqual("bracket after LF no hang", 0, characters[1].x);
pluginAssertEqual("bracket after LF indents (neg)", bracket, characters[3].x);
characters = layout("「あ」\nい", 1);
pluginAssertEqual("paired close resets", 0, characters[3].x);
characters = layout("「あ』\nい", 1);
pluginAssertEqual("unpaired close keeps", bracket, characters[3].x);
characters = layout("「あ『い』\nう", 1);
pluginAssertEqual("nested close keeps", bracket, characters[5].x);
characters = layout("」\n「あ\nい", 1);
pluginAssertEqual("negative depth blocks indent", 0, characters[3].x);
ai.clear();
ai.render("「あ", 1, 0, 0, false);
ai.done();
ai.render("\nい", 1, 0, 0, false);
ai.done();
characters = ai.getCharacters(0, 0);
pluginAssertEqual("indent survives done", bracket, characters[2].x);
ai.setOption(%["begin" => "*", "end" => "~"]);
characters = layout("*あ\nい", 1);
pluginAssertEqual("option begin", characters[0].cw, characters[2].x);
characters = layout("*あ~\nい", 1);
pluginAssertEqual("option end", 0, characters[3].x);
characters = layout("「あ\nい", 1);
pluginAssertEqual("option replaced default", 0, characters[2].x);
pluginSmokePass("TextRender.dll");
System.exit(0);
