Scripts.execStorage("../common/plugin_assert.tjs");
Plugins.link("TextRender.dll");
var window = new Window();
var layer = new Layer(window, null);
var renderer = new TextRenderBase();
renderer.setDefault(%["fontSize" => 30]);
renderer.setRenderSize(1280, 720);
renderer.bold = true;
renderer.italic = true;
renderer.chColor = 0x123456;
renderer.pitch = 3;
renderer.render("A%135;B%;C", 0, 0, 1, false);
renderer.done();
var characters = renderer.getCharacters(0, 0);
pluginAssertEqual("character count", 3, characters.count);
pluginAssertEqual("initial size", 30, characters[0].size);
pluginAssertEqual("enlarged size", 40, characters[1].size);
pluginAssertEqual("restored size", 30, characters[2].size);
pluginAssertEqual("restored text", "C", characters[2].text);
pluginAssertTrue("bold retained", characters[2].bold);
pluginAssertTrue("italic retained", characters[2].italic);
pluginAssertEqual("color retained", 0x123456, characters[2].color);
pluginAssertEqual("pitch retained", 3, renderer.pitch);
renderer.render("%;%;", 0, 0, 1, false);
pluginAssertEqual("repeated reset", 30, renderer.fontSize);
renderer.defaultFontSize = 22;
renderer.render("%135;D%;E", 0, 0, 1, false);
renderer.done();
characters = renderer.getCharacters(0, 0);
pluginAssertEqual("new default enlarged", 29, characters[3].size);
pluginAssertEqual("new default restored", 22, characters[4].size);
pluginAssertTrue("repeat bold retained", characters[4].bold);
pluginSmokePass("TextRender.dll");
System.exit(0);
