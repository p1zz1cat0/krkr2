Scripts.execStorage("../common/plugin_assert.tjs");
Plugins.link("TextRender.dll");
var window = new Window();
var layer = new Layer(window, null);
var renderer = new TextRenderBase();
renderer.setDefault(%["fontSize" => 30]);
renderer.setRenderSize(1280, 720);
renderer.bold = true;
renderer.italic = true;
renderer.chColor = 0x123456;
renderer.pitch = 3;
renderer.render("A%135;B%;C", 0, 0, 1, false);
renderer.done();
var characters = renderer.getCharacters(0, 0);
pluginAssertEqual("character count", 3, characters.count);
pluginAssertEqual("initial size", 30, characters[0].size);
pluginAssertEqual("enlarged size", 40, characters[1].size);
pluginAssertEqual("restored size", 30, characters[2].size);
pluginAssertEqual("restored text", "C", characters[2].text);
pluginAssertTrue("bold retained", characters[2].bold);
pluginAssertTrue("italic retained", characters[2].italic);
pluginAssertEqual("color retained", 0x123456, characters[2].color);
pluginAssertEqual("pitch retained", 3, renderer.pitch);
renderer.render("%;%;", 0, 0, 1, false);
pluginAssertEqual("repeated reset", 30, renderer.fontSize);
renderer.defaultFontSize = 22;
renderer.render("%135;D%;E", 0, 0, 1, false);
renderer.done();
characters = renderer.getCharacters(0, 0);
pluginAssertEqual("new default enlarged", 29, characters[3].size);
pluginAssertEqual("new default restored", 22, characters[4].size);
pluginAssertTrue("repeat bold retained", characters[4].bold);
// The original TextRender.dll reads lowercase setDefault keys and centers
// with align/valign = 0. RIDDLE JOKER choice buttons use exactly this call.
var centered = new TextRenderBase();
centered.setDefault(%["fontsize" => 36, "align" => 0, "valign" => 0]);
pluginAssertEqual("lowercase fontsize", 36, centered.defaultFontSize);
pluginAssertEqual("default align", 0, centered.defaultAlign);
pluginAssertEqual("default valign", 0, centered.defaultValign);
centered.setRenderSize(1000, 80);
centered.render("ABCD", 0, 0, 0, false);
centered.done();
characters = centered.getCharacters(0, 0);
var left = characters[0].x;
var right = characters[3].x + characters[3].cw;
pluginAssertEqual("centered size", 36, characters[0].size);
pluginAssertTrue("centered horizontally", left > 0 && (left - (1000 - right)) <= 1 && ((1000 - right) - left) <= 1);
pluginAssertEqual("centered vertically", 22, characters[0].y);
centered.done();
pluginAssertEqual("second done keeps position", left, centered.getCharacters(0, 0)[0].x);
centered.clear();
centered.render("%RAB", 0, 0, 0, false);
centered.done();
characters = centered.getCharacters(0, 0);
pluginAssertEqual("right aligned", 1000, characters[1].x + characters[1].cw);
// Auto-indent rules from textrender.dll (feature 0015, REVERSE section 10).
// A line after LF starts at the indent, so the tests do not need wraps.
var ai = new TextRenderBase();
ai.setDefault(%["fontsize" => 30]);
ai.setRenderSize(1000, 720);
function layout(text, ind) {
    ai.clear();
    ai.render(text, ind, 0, 0, false);
    ai.done();
    return ai.getCharacters(0, 0);
}
characters = layout("「あ\nい", 0);
pluginAssertEqual("autoIndent 0 no indent", 0, characters[2].x);
characters = layout("「あ\nい", 1);
var bracket = characters[0].cw;
pluginAssertTrue("bracket has width", bracket > 0);
pluginAssertEqual("indent after open bracket", bracket, characters[2].x);
characters = layout("「あ\nい", -1);
pluginAssertEqual("first bracket hangs", -bracket, characters[0].x);
pluginAssertEqual("text after hang at margin", 0, characters[1].x);
pluginAssertEqual("hang indent is margin", 0, characters[2].x);
characters = layout("あ「い\nう", -1);
pluginAssertEqual("plain first char no hang", 0, characters[0].x);
pluginAssertEqual("mid-line bracket no indent", 0, characters[3].x);
characters = layout("あ\n「い\nう", 1);
pluginAssertEqual("bracket after LF indents", bracket, characters[3].x);
characters = layout("あ\n「い\nう", -1);
pluginAssertEqual("bracket after LF no hang", 0, characters[1].x);
pluginAssertEqual("bracket after LF indents (neg)", bracket, characters[3].x);
characters = layout("「あ」\nい", 1);
pluginAssertEqual("paired close resets", 0, characters[3].x);
characters = layout("「あ』\nい", 1);
pluginAssertEqual("unpaired close keeps", bracket, characters[3].x);
characters = layout("「あ『い』\nう", 1);
pluginAssertEqual("nested close keeps", bracket, characters[5].x);
characters = layout("」\n「あ\nい", 1);
pluginAssertEqual("negative depth blocks indent", 0, characters[3].x);
ai.clear();
ai.render("「あ", 1, 0, 0, false);
ai.done();
ai.render("\nい", 1, 0, 0, false);
ai.done();
characters = ai.getCharacters(0, 0);
pluginAssertEqual("indent survives done", bracket, characters[2].x);
ai.setOption(%["begin" => "*", "end" => "~"]);
characters = layout("*あ\nい", 1);
pluginAssertEqual("option begin", characters[0].cw, characters[2].x);
characters = layout("*あ~\nい", 1);
pluginAssertEqual("option end", 0, characters[3].x);
characters = layout("「あ\nい", 1);
pluginAssertEqual("option replaced default", 0, characters[2].x);
// Check the raw timeline against the original DLL's pass-03/04 observations.
var timed = new TextRenderBase();
timed.setDefault(%["fontsize" => 30]);
timed.setRenderSize(1000, 720);
function timeline(text, diff = 10, all = 0) {
    timed.clear();
    timed.render(text, 0, diff, all, false);
    timed.done();
    return timed.getCharacters(0, 0);
}
characters = timeline("AB");
pluginAssertEqual("first delay", 0, characters[0].delay);
pluginAssertEqual("second delay", 10, characters[1].delay);
pluginAssertEqual("tail interval", 20, timed.renderDelay);
pluginAssertEqual("before first", 0, timed.calcShowCount(-1));
pluginAssertEqual("first visible", 1, timed.calcShowCount(0));
pluginAssertEqual("before second", 1, timed.calcShowCount(9));
pluginAssertEqual("second visible", 2, timed.calcShowCount(10));
pluginAssertEqual("past end", 2, timed.calcShowCount(100));
characters = timeline("ABCDE");
timed.render("XY", 0, 10, 0, true);
timed.done();
characters = timed.getCharacters(0, 0);
pluginAssertEqual("same duration keeps longer track", 50, timed.renderDelay);
pluginAssertEqual("same count", 7, characters.count);
pluginAssertEqual("same first old", "A", characters[0].text);
pluginAssertEqual("same first new", "X", characters[1].text);
pluginAssertEqual("same second old", "B", characters[2].text);
pluginAssertEqual("same second new", "Y", characters[3].text);
pluginAssertEqual("same reveal", 4, timed.calcShowCount(10));
pluginAssertEqual("range start", "X", timed.getCharacters(1, 2)[0].text);
pluginAssertEqual("range count", 2, timed.getCharacters(1, 2).count);
characters = timeline("ABCDE");
timed.render("XY", 0, 10, 0, false);
timed.done();
characters = timed.getCharacters(0, 0);
pluginAssertEqual("new track duration", 20, timed.renderDelay);
pluginAssertEqual("old track zero", 0, characters[4].delay);
pluginAssertEqual("new track delay", 10, characters[6].delay);
characters = timeline("AB");
timed.render("VWXYZ", 0, 10, 0, true);
timed.done();
pluginAssertEqual("same longer new track", 50, timed.renderDelay);
characters = timeline("ABC", 10, 60);
pluginAssertEqual("all second", 20, characters[1].delay);
pluginAssertEqual("all third", 40, characters[2].delay);
pluginAssertEqual("all duration", 60, timed.renderDelay);
characters = timeline("ABC", 0, 60);
pluginAssertEqual("all without diff", 40, characters[2].delay);
characters = timeline("ABC");
timed.timeScale = 2;
pluginAssertEqual("scaled duration", 60, timed.renderDelay);
pluginAssertEqual("raw delay stays unscaled", 10, timed.getCharacters(0, 0)[1].delay);
pluginAssertEqual("scaled boundary before", 1, timed.calcShowCount(19));
pluginAssertEqual("scaled boundary exact", 2, timed.calcShowCount(20));
timed.timeScale = 1;
characters = timeline("A%a2;BC");
pluginAssertEqual("absolute speed", 12, characters[2].delay);
pluginAssertEqual("absolute tail", 22, timed.renderDelay);
characters = timeline("A%d200;B%d;CD");
pluginAssertEqual("relative speed", 30, characters[2].delay);
pluginAssertEqual("relative reset", 40, characters[3].delay);
characters = timeline("A%d0;BC");
pluginAssertEqual("zero speed", 10, characters[2].delay);
pluginAssertEqual("zero speed tail", 20, timed.renderDelay);
characters = timeline("A%w200;B");
pluginAssertEqual("relative wait", 30, characters[1].delay);
characters = timeline("A%t200;B");
pluginAssertEqual("absolute wait", 210, characters[1].delay);
characters = timeline("A%t200;");
pluginAssertEqual("trailing wait has no character", 10, timed.renderDelay);
characters = timeline("AB%D5;C");
pluginAssertEqual("sync compress", 2.5, characters[1].delay);
pluginAssertEqual("sync target", 5, characters[2].delay);
pluginAssertEqual("sync tail", 15, timed.renderDelay);
characters = timeline("AB%D60;C");
pluginAssertEqual("sync preserves earlier", 10, characters[1].delay);
pluginAssertEqual("sync waits", 60, characters[2].delay);
// The original synchronization helper keeps completed segments fixed.
characters = timeline("AB%D20;CD", 10, 60);
pluginAssertEqual("all preserves completed segment", 10, characters[1].delay);
pluginAssertEqual("all preserves anchor", 20, characters[2].delay);
pluginAssertEqual("all scales final segment", 40, characters[3].delay);
pluginAssertEqual("all with anchor duration", 60, timed.renderDelay);
timed.setOption(%["ignore_delay" => true]);
characters = timeline("A%t200;B%d200;C");
pluginAssertEqual("ignore markup delays", 20, characters[2].delay);
timed.setOption(%["ignore_delay" => false, "width_time_scale" => true]);
characters = timeline("AAA");
pluginAssertTrue("width timing", Math.abs(characters[1].delay - 10.0 * characters[0].cw / 30) < 0.001);
pluginAssertTrue("width tail", Math.abs(timed.renderDelay - characters[2].delay - 10) < 0.001);
timed.setOption(%["width_time_scale" => false]);
timed.clear();
pluginAssertEqual("clear duration", 0, timed.renderDelay);
pluginAssertEqual("clear reveal", 0, timed.calcShowCount(0));

characters = timeline("AB");
timed.render("%rCD", 0, 10, 0, true);
timed.done();
pluginAssertEqual("font reset keeps text", "ABCD", timed.renderText);
pluginAssertEqual("font reset keeps total time", 20, timed.renderDelay);
characters = timeline("ABCDEFGHIJKLMNOPQRST");
timed.render("abcdefghijklmnopqrst", 0, 10, 0, true);
timed.done();
characters = timed.getCharacters(0, 0);
pluginAssertEqual("large same count", 40, characters.count);
pluginAssertEqual("large same duration", 200, timed.renderDelay);
for (var i = 0; i < 20; ++i) {
    pluginAssertEqual("large old delay", i * 10, characters[i * 2].delay);
    pluginAssertEqual("large new delay", i * 10, characters[i * 2 + 1].delay);
}
var rejected = false;
try { timed.timeScale = -1; } catch (e) { rejected = true; }
pluginAssertTrue("negative scale rejected", rejected);
rejected = false;
try { var ignored = timed.render("%d999999999999999999999;A", 0, 10, 0, false); }
catch (e) { rejected = true; }
pluginAssertTrue("speed overflow rejected", rejected);
// Use equal glyph sizes so the ruby coordinates have exact measured ratios.
var rt = new TextRenderBase();
rt.setDefault(%["fontsize" => 30, "rubysize" => 30, "rubyoffset" => -2]);
rt.setRenderSize(1000, 720);
function rubyLayout(text) {
    rt.clear();
    rt.render(text, 0, 10, 0, false);
    rt.done();
    return rt.getCharacters(0, 0);
}
characters = rubyLayout("[AA]AB");
var cw = characters[0].cw;
pluginAssertTrue("ruby measured glyph", cw > 0);
pluginAssertEqual("single ruby text", "AA", characters[0].ruby.text);
pluginAssertEqual("single ruby center", -cw / 2.0, characters[0].ruby.x);
pluginAssertEqual("ruby y", -28, characters[0].ruby.y);
pluginAssertEqual("ruby size", 30, characters[0].ruby.size);
pluginAssertTrue("following has no ruby", characters[1].ruby === void);
characters = rubyLayout("A[AA]B");
pluginAssertTrue("ruby binds forward", characters[0].ruby === void);
pluginAssertEqual("ruby next glyph", "AA", characters[1].ruby.text);
characters = rubyLayout("[AA,1]AA");
pluginAssertEqual("group count", 2, characters.count);
pluginAssertEqual("first array", 1, characters[0].ruby.count);
pluginAssertEqual("second array", 1, characters[1].ruby.count);
pluginAssertEqual("group first x", 0, characters[0].ruby[0].x);
pluginAssertEqual("group second x", 0, characters[1].ruby[0].x);
characters = rubyLayout("[AA,2]AAA");
pluginAssertEqual("three base group", 3, characters.count);
pluginAssertEqual("spread ruby x", cw, characters[1].ruby[0].x);
characters = rubyLayout("[AAAA,1]AAA");
pluginAssertEqual("dense first count", 2, characters[0].ruby.count);
pluginAssertEqual("dense second count", 2, characters[1].ruby.count);
pluginAssertEqual("dense first x", -cw, characters[0].ruby[0].x);
pluginAssertEqual("dense last x", cw, characters[1].ruby[1].x);
characters = rubyLayout("[AA,2]AA");
pluginAssertEqual("pending group hidden", 0, characters.count);
pluginAssertEqual("pending duration", 0, rt.renderDelay);
rt.done();
pluginAssertEqual("done keeps group pending", 0, rt.getCharacters(0, 0).count);
rt.render("A", 0, 10, 0, false);
rt.done();
characters = rt.getCharacters(0, 0);
pluginAssertEqual("group crosses render", 3, characters.count);
pluginAssertEqual("cross render ruby", "A", characters[0].ruby[0].text);
pluginAssertEqual("cross render timing", 20, characters[2].delay);
characters = rubyLayout("[AA,2]A\nBC");
pluginAssertEqual("LF drops buffered base", 2, characters.count);
pluginAssertEqual("LF keeps following text", "B", characters[0].text);
pluginAssertTrue("LF discards ruby", characters[0].ruby === void);
pluginAssertTrue("LF advances line", characters[0].y > 0);
characters = rubyLayout("[AA,2]A%n;BC");
pluginAssertEqual("percent n drops buffered base", 2, characters.count);
pluginAssertTrue("percent n discards ruby", characters[0].ruby === void);
characters = rubyLayout("[AA,2]A");
rt.render("\nBC", 0, 10, 0, false);
rt.done();
pluginAssertEqual("cross render LF drops group", 2, rt.getCharacters(0, 0).count);
characters = rubyLayout("[AA,2]A");
rt.clear();
rt.render("B", 0, 10, 0, false);
rt.done();
pluginAssertEqual("clear drops pending base", "B", rt.getCharacters(0, 0)[0].text);
pluginAssertTrue("clear drops pending ruby", rt.getCharacters(0, 0)[0].ruby === void);
rt.setRenderSize(cw * 2 + 1, 720);
characters = rubyLayout("[AA,2]AAA");
pluginAssertTrue("ruby group wraps", characters[2].y > characters[0].y);
pluginAssertEqual("wrap keeps relative ruby", cw, characters[1].ruby[0].x);
rejected = false;
try { var ignored = rt.render("[A,999999999999999999999]B", 0, 10, 0, false); }
catch (e) { rejected = true; }
pluginAssertTrue("ruby count overflow rejected", rejected);
rt.clear();
rt.setRenderSize(1000, 720);
rt.rubySize = 0;
rt.render("[AA,1]AA", 0, 10, 0, false);
rt.done();
pluginAssertEqual("zero size ruby is finite", 2, rt.getCharacters(0, 0).count);
pluginSmokePass("TextRender.dll");
System.exit(0);
