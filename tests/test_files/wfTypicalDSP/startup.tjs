Scripts.execStorage("../common/plugin_assert.tjs");
Plugins.link("wfTypicalDSP.dll");
Plugins.link("wfTypicalDSP.dll");
var low = new WaveSoundBuffer.WaveDSPFilter("LowPass", "Butterworth");
low.setParams(void, 2, 1080, void, void, void);
pluginAssertTrue("native interface", low.interface != 0);
var band = new WaveSoundBuffer.WaveDSPFilter("BandPass", "Butterworth");
band.setParams(void, 2, 1300, 1800, void, void);
var sound = new WaveSoundBuffer(null);
sound.filters.add(low);
sound.filters.add(band);
sound.open("../wuvorbis/test.ogg");
pluginAssertEqual("source sample rate", 22050, sound.frequency);
sound.play();
sound.stop();
sound.open("../wuvorbis/test.ogg");
sound.play();
sound.stop();
invalidate sound;
var next = new WaveSoundBuffer(null);
next.filters.add(low);
next.open("../wuvorbis/test.ogg");
low = void;
next.filters.clear();
next.play();
next.stop();
invalidate next;
pluginSmokePass("wfTypicalDSP.dll");
System.exit(0);
