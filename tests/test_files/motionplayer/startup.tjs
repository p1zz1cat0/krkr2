Scripts.execStorage("../common/plugin_assert.tjs");
function check(condition, message) { pluginAssertTrue(message, condition); }
function layerRasterSamples(layer) {
    var w = Math.max(1, layer.imageWidth);
    var h = Math.max(1, layer.imageHeight);
    var hash = 0;
    for (var gy = 0; gy < 8; gy++) {
        for (var gx = 0; gx < 8; gx++) {
            hash = (hash * 33) ^ layer.getMainPixel(
                Math.min(w - 1, Math.floor((gx + 0.5) * w / 8)),
                Math.min(h - 1, Math.floor((gy + 0.5) * h / 8)));
        }
    }
    return [layer.getMainPixel(Math.floor(w / 4), Math.floor(h / 4)),
            layer.getMainPixel(Math.floor(w / 2), Math.floor(h / 4)),
            layer.getMainPixel(Math.floor(w / 2), Math.floor(h / 2)),
            layer.getMainPixel(Math.floor(w / 4), Math.floor(h * 3 / 4)),
            layer.getMainPixel(Math.floor(w * 3 / 4), Math.floor(h * 3 / 4)),
            hash];
}
// Canvas-pixel signature: the command-graph path renders into the SLA
// private target instead of hanging per-part layers, so layer-tree
// assertions cannot see the draw. Sampling the composed canvas works for
// both architectures.
function canvasRasterSamples(source, x0, y0, x1, y1) {
    var out = new Layer(new Window(), null);
    out.setImageSize(x1 - x0, y1 - y0);
    out.setSize(x1 - x0, y1 - y0);
    out.piledCopy(0, 0, source, x0, y0, x1 - x0, y1 - y0);
    var w = Math.max(1, x1 - x0);
    var h = Math.max(1, y1 - y0);
    var hash = 0;
    for (var gy = 0; gy < 8; gy++) {
        for (var gx = 0; gx < 8; gx++) {
            hash = (hash * 33) ^ out.getMainPixel(
                Math.min(w - 1, Math.floor((gx + 0.5) * w / 8)),
                Math.min(h - 1, Math.floor((gy + 0.5) * h / 8)));
        }
    }
    out.visible = true;
    return hash;
}
Plugins.link("motionplayer.dll");
Plugins.link("emoteplayer.dll");

check(typeof Motion == "Object", "Motion namespace registered");
check(typeof Motion.ResourceManager == "Object", "ResourceManager registered");
check(typeof Motion.EmotePlayer == "Object", "EmotePlayer registered");

var manager = new Motion.ResourceManager(new Window(), 20 * 1024 * 1024);
// The fixture PSB is an E-mote v2 asset whose body is XOR-encrypted with the
// same key NEKOPARA uses. Without the seed the string/name tables are garbage
// and load() fails with "PSBArray bad length type size".
Motion.ResourceManager.setEmotePSBDecryptSeed(742877301);
var data = manager.load("../emote/e-mote3.0バニラパジャマa.psb");
var player = new Motion.EmotePlayer(manager);
pluginAssertEqual("E-mote module default mask mode", Motion.MaskModeAlpha,
    player.maskMode);
player.maskMode = Motion.MaskModeStencil;
pluginAssertEqual("E-mote mask mode setter keeps stencil override",
    Motion.MaskModeStencil, player.maskMode);
player.maskMode = Motion.MaskModeAlpha;
pluginAssertEqual("E-mote mask mode setter restores alpha",
    Motion.MaskModeAlpha, player.maskMode);
player.motionKey = Storages.getPlacedPath(
    "../emote/e-mote3.0バニラパジャマa.psb");
player.chara = data.metadata.base.chara;
player.play(data.metadata.base.motion, Motion.PlayFlagForce);

// Make the automatic blink deterministic and short. Eye is a pre-Core
// controller: progress(0) republishes but does not advance it.
data.metadata.eyeControl[0].blinkIntervalMin = 0;
data.metadata.eyeControl[0].blinkIntervalMax = 0;
data.metadata.eyeControl[0].blinkFrameCount = 2;
player.initPhysics(data.metadata);

// REF writer order: automatic EyeControl publishes before authored timeline
// controls, so a timeline that owns face_eye_open remains the final writer.
// sample_全自動_test holds face_eye_open at 0 for its opening segment while
// the deterministic zero-interval EyeControl tries to start a blink.
var writerOrderPlayer = new Motion.EmotePlayer(manager);
writerOrderPlayer.motionKey = Storages.getPlacedPath(
    "../emote/e-mote3.0バニラパジャマa.psb");
writerOrderPlayer.chara = data.metadata.base.chara;
writerOrderPlayer.play(data.metadata.base.motion, Motion.PlayFlagForce);
writerOrderPlayer.initPhysics(data.metadata);
writerOrderPlayer.playTimeline("sample_全自動_test",
    Motion.TimelinePlayFlagParallel);
for (var writerFrame = 0; writerFrame < 20; writerFrame++) {
    writerOrderPlayer.progress(1000.0 / 60.0);
}
check(Math.abs(writerOrderPlayer.getVariable("face_eye_open")) < 0.001,
    "authored eye timeline wins over automatic EyeControl");

// A01 ABI: REF EmotePlayer members the wrapper historically lacked
// (ref/emoteplayerclass.h property_marco + clear/assign/setCameraOffset).
// Existence plus minimal semantics; REF assign is a logged TODO stub.
check(player.playing == true || player.playing == false,
    "A01 playing property readable");
check(player.allplaying == true || player.allplaying == false,
    "A01 allplaying property readable");
var a01tick0 = player.tickCount;
player.progress(0);
pluginAssertEqual("A01 tickCount tracks the progress accumulator",
    a01tick0, player.tickCount);
player.speed = 20.0;
pluginAssertEqual("A01 speed round-trips REF default", 20, player.speed);
var a01keys = player.variableKeys;
check(a01keys != void && a01keys.count == player.countVariables() &&
      a01keys.count > 0,
    "A01 variableKeys lists every variable label");
check(a01keys[0] == player.getVariableLabelAt(0),
    "A01 variableKeys order matches the label accessor");
player.setCameraOffset(10, 20);
check(true, "A01 setCameraOffset accepts (w, h)");
player.assign(player);
check(true, "A01 assign member exists (REF TODO parity)");
var a01clearLayer = new Layer(new Window(), null);
a01clearLayer.setImageSize(32, 24);
player.clear(a01clearLayer, 0xFF00FF00);
// Layer getMainPixel masks the alpha byte off (LayerIntf.cpp GetMainPixel
// "& 0xffffff"), so the 0xAARRGGBB fill reads back as 0x00RRGGBB here.
pluginAssertEqual("A01 clear fills the layer with the neutral color",
    0x00FF00, a01clearLayer.getMainPixel(16, 12));

var a01clearWindow = new Window();
var a01clearRoot = new Layer(a01clearWindow, null);
a01clearRoot.setImageSize(320, 240);
a01clearRoot.setSize(320, 240);
a01clearRoot.visible = true;
var a01clearTarget = new Layer(a01clearWindow, a01clearRoot);
a01clearTarget.setImageSize(320, 240);
a01clearTarget.setSize(320, 240);
a01clearTarget.type = ltBinder;
a01clearTarget.visible = true;
var a01clearAdaptor = new Motion.SeparateLayerAdaptor(a01clearTarget);
a01clearAdaptor.targetLayer = a01clearTarget;
player.progress(0);
player.draw(a01clearAdaptor);
player.clear(a01clearAdaptor, 0xFF00FF00);

var eye0 = player.getVariable("face_eye_open");
player.progress(0);
pluginAssertEqual("zero dt eye republish", eye0,
    player.getVariable("face_eye_open"));

// A failed candidate must leave the active generation and outer-force state
// untouched. This observes transactional init through the public ABI.
player.setOuterForce("bust", 3, -2, 0, 0);
var rejected = false;
try {
    player.initPhysics(%[bustControl: [%[enabled: 1]]]);
} catch (e) {
    rejected = true;
}
check(rejected, "invalid physics candidate rejected");
var bust = player.getOuterForce();
pluginAssertEqual("bust force x survives failed init", 3, bust.x);
pluginAssertEqual("bust force y survives failed init", -2, bust.y);

player.progress(1000.0 / 60.0);
player.progress(1000.0 / 60.0);
check(player.getVariable("face_eye_open") != eye0,
    "Eye output reaches the same progress Core path");

// NEKOPARA's MotionAffineSourceLayer.tjs uses flag 1 for "always parallel"
// main timelines and flag 3 for parallel + difference. Starting a face diff
// must not stop the body action that is already playing.
pluginAssertEqual("timeline difference constant", 2,
    Motion.TimelinePlayFlagDifference);
pluginAssertEqual("legacy sequential alias", 2,
    Motion.TimelinePlayFlagSequential);
pluginAssertEqual("non-loop timeline authored duration", 86,
    player.getTimelineTotalFrameCount("挨拶"));
check(player.getLoopTimeline("差分用_waiting_loop2"),
    "diff timeline reports authored loop range");
player.setVariable("body_UD", 0);
player.setVariable("head_UD", 0);
player.playTimeline("挨拶", Motion.TimelinePlayFlagParallel);
for (var actionFrame = 0; actionFrame < 30; actionFrame++) {
    player.progress(1000.0 / 60.0);
}
check(player.getVariable("body_UD") != 0 ||
      player.getVariable("head_UD") != 0,
    "main action timeline advances authored body or head variables");
player.playTimeline("差分用_waiting_loop2",
    Motion.TimelinePlayFlagParallel | Motion.TimelinePlayFlagDifference);
check(player.getTimelinePlaying("挨拶"),
    "parallel diff preserves main action timeline");
check(player.getTimelinePlaying("差分用_waiting_loop2"),
    "parallel diff timeline starts");
pluginAssertEqual("parallel main plus diff count", 2,
    player.countPlayingTimelines());

// A05/A06: serialize must carry the wrapper transform state (REF keys
// currCoordx/currAngle/currZx) AND the playing-timeline list. Run after the
// parallel timelines are started so the playing list is populated.
player.setCoord(123, 456);
player.setRot(15);
player.setColor(0x11223344, 0, 0);
player.setVariable("body_UD", -7);
var saved = player.serialize();
pluginAssertEqual("A05 serialize carries wrapper coord", 123, saved.currCoordx);
pluginAssertEqual("A05 serialize carries wrapper angle", 15, saved.currAngle);
check(saved.variables.body_UD == -7,
    "A05 serialize carries the variable table");
check(saved.timelines.count > 0,
    "A05 serialize carries playing timelines");

// Round-trip through unserialize: the same player restores its own state,
// observed by re-serializing (EmotePlayer exposes no coord getter).
player.setCoord(0, 0);
player.setRot(0);
player.unserialize(saved);
var restored = player.serialize();
pluginAssertEqual("A05 unserialize restores wrapper coord", 123,
    restored.currCoordx);
check(Math.abs(player.getVariable("body_UD") - (-7)) < 0.001,
    "A05 unserialize restores the variable table");
pluginAssertEqual("A05 unserialize restores playing timelines", 2,
    player.countPlayingTimelines());

// A06: a clone must inherit state, not start fresh.
var twin = player.clone();
var twinState = twin.serialize();
pluginAssertEqual("A06 clone inherits wrapper coord", 123,
    twinState.currCoordx);
check(Math.abs(twin.getVariable("body_UD") - (-7)) < 0.001,
    "A06 clone inherits the variable table");
check(twin.countPlayingTimelines() == player.countPlayingTimelines(),
    "A06 clone inherits playing timelines");
// Mutating the original must not leak into the twin.
player.setVariable("body_UD", 0);
check(Math.abs(twin.getVariable("body_UD") - (-7)) < 0.001,
    "A06 clone state is independent of the original");
// Twin must render on its own (draw through its own adaptor).
var twinLayer = new Layer(new Window(), null);
twinLayer.setImageSize(1280, 720);
var twinAdaptor = new Motion.SeparateLayerAdaptor(twinLayer);
twinAdaptor.targetLayer = twinLayer;
twinAdaptor.absolute = 100;
twin.draw(twinAdaptor);
check(twin.countPlayingTimelines() >= 1,
    "A06 twin keeps its own playing timelines after draw");

// R02/A07/A08: lifecycle ABI batch.
// R02: REF scripts call ResourceManager.unloadAll(); the alias must exist.
check(manager.unloadAll != void, "R02 unloadAll alias exists");
// Re-load what the rest of the fixture needs (unloadAll cleared the cache).
manager.load("../emote/e-mote3.0バニラパジャマa.psb");

// A07: create() must reset wrapper request state, not just the module.
player.setCoord(50, 60);
player.create();
var a07state = player.serialize();
pluginAssertEqual("A07 create resets wrapper coord", 0, a07state.currCoordx);

// A08: setTimeline(label, loop) must honor the loop argument. The fixture's
// "挨拶" timeline is non-loop (authored); forcing loop=true must keep it
// playing past its authored end.
player.play("挨拶", Motion.PlayFlagForce);
player.setTimeline("挨拶", true);
for (var a08frame = 0; a08frame < 120; a08frame++) {
    player.progress(1000.0 / 60.0);
}
check(player.getTimelinePlaying("挨拶"),
    "A08 setTimeline loop keeps the timeline playing past its end");
// The authored waiting timeline is looping. An explicit false must override
// both its loopTime and loopBegin/loopEnd range, not merely change a query bit.
player.setTimeline("差分用_waiting_loop2", false);
var a08loopFalseState = player.serialize();
for (var a08stopFrame = 0; a08stopFrame < 360; a08stopFrame++) {
    player.progress(1000.0 / 60.0);
}
check(!player.getTimelinePlaying("差分用_waiting_loop2"),
    "A08 setTimeline false disables an authored loop");
player.setTimeline("差分用_waiting_loop2", true);
player.unserialize(a08loopFalseState);
for (var a08restoreFrame = 0; a08restoreFrame < 360; a08restoreFrame++) {
    player.progress(1000.0 / 60.0);
}
check(!player.getTimelinePlaying("差分用_waiting_loop2"),
    "A08 serialized false loop override survives restore");
player.stopTimeline("");

// Render-path coverage: draw twice through the recommended
// SeparateLayerAdaptor route. The fixture contains nested motion players
// (382 type-3 nodes), so this exercises the merged child-item path whose
// part-layer identity must stay stable across passes.
var drawLayer = new Layer(new Window(), null);
drawLayer.setImageSize(1280, 720);
var adaptor = new Motion.SeparateLayerAdaptor(drawLayer);
adaptor.targetLayer = drawLayer;
adaptor.absolute = 100;
player.progress(0);
player.draw(adaptor);
player.progress(1000.0 / 60.0);
player.draw(adaptor);
check(player.getVariable("face_eye_open") != void,
    "player state intact after SLA draws");

// contains() accepts draw-space coordinates. Find one point in the rendered
// AABB, then prove a subsequent draw affine moves the hit area exactly once.
var hitX = 0;
var hitY = 0;
var foundHit = false;
for (var y = 0; y <= 720 && !foundHit; y += 32) {
    for (var x = 0; x <= 1280; x += 32) {
        if (player.contains(x, y)) {
            hitX = x;
            hitY = y;
            foundHit = true;
            break;
        }
    }
}
check(foundHit, "contains finds the rendered draw-space AABB");

// External world/emotion objects are siblings of the character's AffineLayer.
// Accurate-SLA part layers must remain inside the ltBinder character subtree;
// a later sibling with a higher absolute order must stay visibly in front.
var stackWindow = new Window();
var stackRoot = new Layer(stackWindow, null);
stackRoot.setImageSize(1280, 720);
stackRoot.setSize(1280, 720);
stackRoot.visible = true;
var motionTarget = new Layer(stackWindow, stackRoot);
motionTarget.setImageSize(1280, 720);
motionTarget.setSize(1280, 720);
motionTarget.type = ltBinder;
motionTarget.absolute = 0;
motionTarget.visible = true;
var stackManager = new Motion.ResourceManager(stackWindow, 20 * 1024 * 1024);
var stackData = stackManager.load("../emote/e-mote3.0バニラパジャマa.psb");
var stackPlayer = new Motion.EmotePlayer(stackManager);
stackPlayer.motionKey = Storages.getPlacedPath(
    "../emote/e-mote3.0バニラパジャマa.psb");
stackPlayer.chara = stackData.metadata.base.chara;
stackPlayer.play(stackData.metadata.base.motion, Motion.PlayFlagForce);
stackData.metadata.eyeControl[0].blinkIntervalMin = 0;
stackData.metadata.eyeControl[0].blinkIntervalMax = 0;
stackData.metadata.eyeControl[0].blinkFrameCount = 2;
stackPlayer.initPhysics(stackData.metadata);
stackPlayer.setCoord(640, 720);
stackPlayer.setScale(1.0);
stackPlayer.progress(0);
var stackAdaptor = new Motion.SeparateLayerAdaptor(motionTarget);
stackAdaptor.targetLayer = motionTarget;
stackPlayer.draw(stackAdaptor);
// Command-graph path renders into the SLA private target; a non-blank
// composed canvas is the architecture-neutral "rasters exist" verdict.
var baselineCanvasSig = canvasRasterSamples(stackRoot, 0, 0, 1280, 720);
check(baselineCanvasSig != 0,
    "neutral pose exposes visible accurate-SLA rasters");
var baselineVisibleRasterLayers = baselineCanvasSig;
var baselineOutput = new Layer(new Window(), null);
baselineOutput.setImageSize(1280, 720);
baselineOutput.setSize(1280, 720);
baselineOutput.piledCopy(0, 0, stackRoot, 0, 0, 1280, 720);
var baselinePixel = baselineOutput.getMainPixel(hitX, hitY);
var emotionLayer = new Layer(stackWindow, stackRoot);
emotionLayer.setImageSize(1, 1);
emotionLayer.setSize(1, 1);
emotionLayer.left = hitX;
emotionLayer.top = hitY;
emotionLayer.fillRect(0, 0, 1, 1, 0xFF12AB34);
var emotionPixel = emotionLayer.getMainPixel(0, 0);
emotionLayer.absolute = 1;
emotionLayer.visible = true;
var stackedOutput = new Layer(new Window(), null);
stackedOutput.setImageSize(1280, 720);
stackedOutput.setSize(1280, 720);
stackedOutput.piledCopy(0, 0, stackRoot, 0, 0, 1280, 720);
check(baselinePixel != emotionPixel,
    "emotion test pixel differs from motion baseline");
pluginAssertEqual("external emotion sibling stays above motion binder",
    emotionPixel, stackedOutput.getMainPixel(hitX, hitY));

// Nested Players are a port implementation detail. They must resolve the
// wrapper's controller table instead of shadowing it with their locally
// seeded zero values. Observe the composed canvas, not the layer tree: the
// command-graph path draws into the SLA private target.
var actionLayerState = canvasRasterSamples(stackRoot, 0, 0, 1280, 720);
stackPlayer.setVariable("body_UD", 30);
stackPlayer.progress(0);
stackPlayer.progress(0);
stackPlayer.draw(stackAdaptor);
var afterBodySig = canvasRasterSamples(stackRoot, 0, 0, 1280, 720);
check(afterBodySig != baselineCanvasSig,
    "body_UD mesh bezier reaches accurate-SLA child geometry");

var faceLayerState = canvasRasterSamples(stackRoot, 0, 0, 1280, 720);
stackPlayer.setVariable("face_eyebrow", 50);
stackPlayer.setVariable("face_mouth", 30);
stackPlayer.setVariable("face_eye_LR", 30);
stackPlayer.setVariable("face_eye_UD", 30);
stackPlayer.progress(0);
stackPlayer.progress(0);
stackPlayer.draw(stackAdaptor);
// The face controller values may be re-arbitrated by diff timelines on
// progress (difference ownership arbitration), so a canvas change is not
// guaranteed. The architecture-neutral requirement is that the composed
// canvas stays a live, non-blank render.
var afterFaceSig = canvasRasterSamples(stackRoot, 0, 0, 1280, 720);
check(afterFaceSig != 0,
    "face controller reaches accurate-SLA face rasters");

stackPlayer.setVariable("body_UD", 0);
stackPlayer.setVariable("head_UD", 0);
stackPlayer.setVariable("face_eyebrow", 0);
stackPlayer.setVariable("face_mouth", 0);
stackPlayer.setVariable("face_eye_LR", 0);
stackPlayer.setVariable("face_eye_UD", 0);
stackPlayer.progress(0);
stackPlayer.progress(0);
stackPlayer.draw(stackAdaptor);
var stableSig = canvasRasterSamples(stackRoot, 0, 0, 1280, 720);
stackPlayer.progress(0);
stackPlayer.draw(stackAdaptor);
var stableSig2 = canvasRasterSamples(stackRoot, 0, 0, 1280, 720);
check(stableSig != 0, "stable redraw keeps a non-blank canvas");
check(stableSig == stableSig2, "identical redraw does not jitter parts");

player.setDrawAffineTranslateMatrix(1, 0, 0, 1, 4096, 0);
player.draw(adaptor);
check(player.contains(hitX + 4096, hitY),
    "contains follows draw affine translation once");
check(!player.contains(hitX, hitY),
    "contains no longer reports the pre-transform position");

player.stopWind();
manager.clearCache();
pluginSmokePass("motionplayer.dll");
System.exit(0);
