// KRKR_EMOTE_EDGE_DIAG canvas probe: measures the final silhouette edge of a
// real E-mote fixture frame the way the compositor actually produced it.
// Method: draw the identical frame (progress(0) is deterministic, proven by
// the motionplayer fixture's identical-redraw check) over a pure black and a
// pure white background. Per pixel, straight-alpha compositing gives
//   out_black = C * a,  out_white = C * a + 255 * (1 - a)
// so alpha and the true edge color C are recoverable from RGB-only reads
// (getMainPixel masks the alpha byte off). Reported per silhouette ramp:
// width in pixels, the mean recovered edge color C, and the interior color
// just inside the ramp. A light fringe (C much brighter than interior) or a
// ramp wider than ~2px is the fingerprint of sampling/compositing damage.
Scripts.execStorage("../common/plugin_assert.tjs");
Plugins.link("motionplayer.dll");
Plugins.link("emoteplayer.dll");

var manager = new Motion.ResourceManager(new Window(), 20 * 1024 * 1024);
Motion.ResourceManager.setEmotePSBDecryptSeed(742877301);
var data = manager.load("../emote/e-mote3.0バニラパジャマa.psb");
var player = new Motion.EmotePlayer(manager);
player.motionKey = Storages.getPlacedPath(
    "../emote/e-mote3.0バニラパジャマa.psb");
player.chara = data.metadata.base.chara;
player.play(data.metadata.base.motion, Motion.PlayFlagForce);
data.metadata.eyeControl[0].blinkIntervalMin = 0;
data.metadata.eyeControl[0].blinkIntervalMax = 0;
data.metadata.eyeControl[0].blinkFrameCount = 2;
player.initPhysics(data.metadata);

var CANVAS_W = 1280;
var CANVAS_H = 720;

function captureOver(bgColor) {
    var win = new Window();
    var root = new Layer(win, null);
    root.setImageSize(CANVAS_W, CANVAS_H);
    root.setSize(CANVAS_W, CANVAS_H);
    root.fillRect(0, 0, CANVAS_W, CANVAS_H, bgColor);
    root.visible = true;
    var motionLayer = new Layer(win, root);
    motionLayer.setImageSize(CANVAS_W, CANVAS_H);
    motionLayer.setSize(CANVAS_W, CANVAS_H);
    motionLayer.type = ltBinder;
    motionLayer.absolute = 0;
    motionLayer.visible = true;
    var adaptor = new Motion.SeparateLayerAdaptor(motionLayer);
    adaptor.targetLayer = motionLayer;
    player.progress(0);
    player.draw(adaptor);
    var capWin = new Window();
    var capture = new Layer(capWin, null);
    capture.setImageSize(CANVAS_W, CANVAS_H);
    capture.setSize(CANVAS_W, CANVAS_H);
    capture.piledCopy(0, 0, root, 0, 0, CANVAS_W, CANVAS_H);
    return capture;
}

var blackCanvas = captureOver(0xFF000000);
var whiteCanvas = captureOver(0xFFFFFFFF);

// Per scanline: recover alpha/edge-color from the black/white pair, then
// measure the leftmost and rightmost background->art silhouette ramps.
var rows = [];
for (var y = 160; y < 700; y += 32) {
    var alpha = [];
    for (var xs = 0; xs < CANVAS_W; xs++) {
        var pb = blackCanvas.getMainPixel(xs, y);
        var pw = whiteCanvas.getMainPixel(xs, y);
        var bGreen = (pb >> 8) & 0xff;
        var wGreen = (pw >> 8) & 0xff;
        var a = 1.0 - (wGreen - bGreen) / 255.0;
        if (a < 0.0) a = 0.0;
        if (a > 1.0) a = 1.0;
        alpha[xs] = a;
    }
    // first entry into art from the left
    var leftStart = -1;
    var leftEnd = -1;
    for (var xl = 1; xl < CANVAS_W; xl++) {
        if (alpha[xl] >= 0.95 && alpha[xl - 1] < 0.95) {
            var s = xl - 1;
            while (s > 0 && alpha[s - 1] > 0.05) s--;
            leftStart = s;
            leftEnd = xl;
            break;
        }
    }
    // last exit from art to the right
    var rightStart = -1;
    var rightEnd = -1;
    for (var xr = CANVAS_W - 2; xr >= 0; xr--) {
        if (alpha[xr] >= 0.95 && alpha[xr + 1] < 0.95) {
            var e = xr + 1;
            while (e < CANVAS_W - 1 && alpha[e + 1] > 0.05) e++;
            rightStart = xr;
            rightEnd = e;
            break;
        }
    }
    rows[rows.length] = [y, leftStart, leftEnd, rightStart, rightEnd];
}

function rampReport(canvas, name, y, rampStart, rampEnd, intoArt) {
    if (rampStart < 0) {
        Debug.message("emote.edge.raster row=" + name + " y=" + y +
            " ramp=none");
        return;
    }
    var rSum = 0, gSum = 0, bSum = 0, n = 0;
    var iRampStart = rampStart;
    var iRampEnd = rampEnd;
    if (!intoArt) {
        iRampStart = rampEnd;
        iRampEnd = rampStart;
    }
    for (var xr = iRampStart; xr <= iRampEnd; xr++) {
        var pb1 = blackCanvas.getMainPixel(xr, y);
        var pw1 = whiteCanvas.getMainPixel(xr, y);
        var bG = (pb1 >> 8) & 0xff;
        var wG = (pw1 >> 8) & 0xff;
        var a = 1.0 - (wG - bG) / 255.0;
        if (a < 0.08) continue;
        // getMainPixel returns 0x00RRGGBB (alpha masked off)
        rSum += ((pb1 >> 16) & 0xff) / a;
        gSum += ((pb1 >> 8) & 0xff) / a;
        bSum += (pb1 & 0xff) / a;
        n++;
    }
    // interior color: 3..10px further inside the art
    var dir = intoArt ? 1 : -1;
    var cR = 0, cG = 0, cB = 0, cn = 0;
    for (var k = 3; k <= 10; k++) {
        var xi = iRampEnd + dir * k;
        if (xi < 0 || xi >= CANVAS_W) break;
        var pb2 = blackCanvas.getMainPixel(xi, y);
        var pw2 = whiteCanvas.getMainPixel(xi, y);
        var bG2 = (pb2 >> 8) & 0xff;
        var wG2 = (pw2 >> 8) & 0xff;
        var a2 = 1.0 - (wG2 - bG2) / 255.0;
        if (a2 < 0.98) continue;
        cR += ((pb2 >> 16) & 0xff) / a2;
        cG += ((pb2 >> 8) & 0xff) / a2;
        cB += (pb2 & 0xff) / a2;
        cn++;
    }
    var cText = cn > 0 ?
        (Math.round(cR / cn) + "," + Math.round(cG / cn) + "," +
         Math.round(cB / cn)) : "n/a";
    Debug.message("emote.edge.raster row=" + name + " y=" + y +
        " rampPx=" + (Math.abs(iRampEnd - iRampStart) + 1) +
        " rampColor=" + (n > 0 ? Math.round(rSum / n) + "," +
            Math.round(gSum / n) + "," + Math.round(bSum / n) : "n/a") +
        " interiorColor=" + cText);
}

for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    var y = row[0];
    if (row[1] >= 0) rampReport(blackCanvas, "left", y, row[1], row[2], true);
    if (row[3] >= 0) rampReport(blackCanvas, "right", y, row[3], row[4], false);
}

Debug.message("emote.edge.raster done rows=" + rows.length);

// Translation-invariant sharpness metric: total count of partially
// transparent pixels over the sampled region. Crisper silhouettes shrink
// the total AA area; unlike per-scanline ramp widths this does not move
// when the content shifts by half a pixel.
var partial = 0;
var sampled = 0;
// Recovered-alpha precision histogram: 16 buckets of 16 levels, plus the
// exact-0 and exact-255 end counts. A quantized composite (4-bit alpha,
// binary threshold) collapses this to a few buckets; a clean 8-bit chain
// spreads it.
var alphaBuckets = [];
for (var bi = 0; bi < 16; bi++) alphaBuckets[bi] = 0;
var exactZero = 0;
var exactFull = 0;
for (var ys = 0; ys < CANVAS_H; ys += 2) {
    for (var xs = 0; xs < CANVAS_W; xs += 2) {
        var pbc = blackCanvas.getMainPixel(xs, ys);
        var pwc = whiteCanvas.getMainPixel(xs, ys);
        var a = 1.0 - (((pwc >> 8) & 0xff) - ((pbc >> 8) & 0xff)) / 255.0;
        if (a > 0.05 && a < 0.95) partial++;
        if (a <= 0.004) { exactZero++; continue; }
        if (a >= 0.996) { exactFull++; continue; }
        var level = Math.floor(a * 16);
        if (level > 15) level = 15;
        alphaBuckets[level]++;
        sampled++;
    }
}
Debug.message("emote.edge.partial partial=" + partial + " sampled=" +
    sampled);
Debug.message("emote.edge.alphaHist zero=" + exactZero + " full=" +
    exactFull + " mid=" + (alphaBuckets[0] + "/" + alphaBuckets[1] + "/" +
    alphaBuckets[2] + "/" + alphaBuckets[3] + "/" + alphaBuckets[4] + "/" +
    alphaBuckets[5] + "/" + alphaBuckets[6] + "/" + alphaBuckets[7] + "/" +
    alphaBuckets[8] + "/" + alphaBuckets[9] + "/" + alphaBuckets[10] + "/" +
    alphaBuckets[11] + "/" + alphaBuckets[12] + "/" + alphaBuckets[13] + "/" +
    alphaBuckets[14] + "/" + alphaBuckets[15]));
pluginSmokePass("edge-diag");
System.exit(0);
