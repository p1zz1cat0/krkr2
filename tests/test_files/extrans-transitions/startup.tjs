Scripts.execStorage("../common/plugin_assert.tjs");
function check(condition, message) { pluginAssertTrue(message, condition); }

Plugins.link("extrans.dll");

var testWindow = new Window();
var destination = new Layer(testWindow, null);
var source = new Layer(testWindow, destination);
source.setImageSize(65, 65);
destination.setImageSize(65, 65);
destination.visible = true;
source.visible = true;
testWindow.visible = true;
for (var y = 0; y < 65; y++) {
    for (var x = 0; x < 65; x++) {
        destination.setMainPixel(x, y, 0xff000000 | (x << 8) | y);
        source.setMainPixel(x, y, 0xff000000 | (y << 16) | x);
    }
}

var invalidRipple = null;
try {
    destination.beginTransition("ripple", false, source,
        %[time: 100, rwidth: 15]);
} catch (e) {
    invalidRipple = e;
}
check(invalidRipple != null, "invalid rwidth rejected");

var invalidMosaic = null;
try {
    destination.beginTransition("mosaic", false, source,
        %[time: 100, maxsize: 0]);
} catch (e) {
    invalidMosaic = e;
}
check(invalidMosaic != null, "invalid mosaic maxsize rejected");

var invalidWave = null;
try {
    destination.beginTransition("wave", false, source,
        %[time: 100, wavetype: 3]);
} catch (e) {
    invalidWave = e;
}
check(invalidWave != null, "invalid wave type rejected");

destination.beginTransition("ripple", false, source, %[
    time: 100,
    centerx: 32,
    centery: 32,
    rwidth: 16,
    roundness: 1.0,
    speed: -6.0,
    maxdrift: 0
]);

var effects = [
    ["wave", %[time: 100, maxh: 8, maxomega: 0.2, wavetype: 0]],
    ["mosaic", %[time: 100, maxsize: 8]],
    ["rotatezoom", %[time: 100, factor: 0.5, twist: 0.25]],
    ["rotatevanish", %[time: 100, twist: 0.25]],
    ["rotateswap", %[time: 100, twist: 0.25, bgcolor: 0xff102030]],
    ["turn", %[time: 100, bgcolor: 0xff102030]]
];
var effectIndex = 0;
var frameCount = 0;
var driveTransitions = function() {
    frameCount++;
    if ((frameCount % 3) == 0) {
        destination.stopTransition();
        if (effectIndex < effects.count) {
            destination.beginTransition(effects[effectIndex][0], false, source,
                effects[effectIndex][1]);
            effectIndex++;
        }
    }
    if (effectIndex >= effects.count && (frameCount % 3) == 2) {
        System.removeContinuousHandler(driveTransitions);
        destination.stopTransition();
        pluginSmokePass("extrans.dll");
        testWindow.visible = false;
        System.exit(0);
    }
};
System.addContinuousHandler(driveTransitions);
