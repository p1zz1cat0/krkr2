Scripts.execStorage("../common/plugin_assert.tjs");

// The alias is loaded first in a fresh process so this checks its callback,
// rather than succeeding through a class registered by the primary name.
Plugins.link("drawdeviceD3DZ.dll");
var device = new DrawDeviceD3D(16, 12);
pluginAssertEqual("alias constructor width", 16, device.width);
pluginAssertEqual("device reports its E-mote module", true,
                  device.checkEnable("emote"));
pluginAssertEqual("unknown module is disabled", false,
                  device.checkEnable("unknown"));
device.setScreenRect(0, 0, 1920, 1080);
device.setPrimarySize(20, 15);
pluginAssertEqual("primary size changes device width", 20, device.width);
pluginAssertEqual("primary size changes device height", 15, device.height);
var snapshot = new D3D(4, 3);
pluginAssertEqual("alias D3D constructor height", 3, snapshot.height);
pluginAssertEqual("offscreen device reports its E-mote module", true,
                  snapshot.checkEnable("emote"));
var layer = new D3DLayer(snapshot);
pluginAssertEqual("alias layer plane", D3DLayer.DrawPlaneBoth,
                  layer.drawPlane);
var image = new D3DImage(snapshot);
pluginAssertEqual("alias empty image width", 0, image.width);
Plugins.link("drawdeviceD3D.dll");
Plugins.link("drawdeviceD3DZ.dll");

var transitionDevice = new D3D(2, 2);
var sourceWindow = new Window();
var source = new Layer(sourceWindow, null);
source.setImageSize(1, 1);
source.setMainPixel(0, 0, 0xfff00000);
var oldImage = new D3DImage(transitionDevice);
oldImage.load(source);
source.setMainPixel(0, 0, 0xff0000f0);
var newImage = new D3DImage(transitionDevice);
newImage.load(source);
var front = new D3DLayer(transitionDevice);
front.drawPlane = D3DLayer.DrawPlaneFront;
var oldPicture = new D3DPicture(front, oldImage);
oldPicture.blendMode = 1;
oldPicture.assignImageRange(0, 0, 1, 1, 0, 0);
var back = new D3DLayer(transitionDevice);
back.drawPlane = D3DLayer.DrawPlaneBack;
var newPicture = new D3DPicture(back, newImage);
newPicture.blendMode = 1;
newPicture.assignImageRange(0, 0, 1, 1, 0, 0);
var output = new Layer(sourceWindow, source);
output.setImageSize(2, 2);
transitionDevice.capture(output, 0);
pluginAssertEqual("transition starts on front plane", 0x00f00000,
                  output.getMainPixel(0, 0));
var transition = new Dictionary();
transition.method = "crossfade";
transition.time = 500;
transitionDevice.startTransition(transition);
transitionDevice.transState = 0.5;
transitionDevice.capture(output, 0);
var middle = output.getMainPixel(0, 0);
pluginAssertTrue("crossfade middle differs from old and new frames",
                 middle != 0x00f00000 && middle != 0x000000f0);
transitionDevice.transState = 0;
transitionDevice.capture(output, 0);
pluginAssertEqual("transition finishes on back plane", 0x000000f0,
                  output.getMainPixel(0, 0));
transitionDevice.stopTransition();
transition.method = "vanish";
var unsupportedTransition = false;
try {
    transitionDevice.startTransition(transition);
} catch (e) {
    unsupportedTransition = true;
}
pluginAssertTrue("unsupported transition is explicit", unsupportedTransition);
transitionDevice.capture(output, 0);
pluginAssertEqual("failed transition preserves visible plane", 0x000000f0,
                  output.getMainPixel(0, 0));

// Universal: KAGWindow.beginTransition passes rule as a loaded Layer and
// vague as an integer. Dark rule pixels switch first, as in the core handler.
transition.method = "universal";
var missingRule = false;
try {
    transitionDevice.startTransition(transition);
} catch (e) {
    missingRule = true;
}
pluginAssertTrue("universal without a rule Layer is explicit", missingRule);
var rule = new Layer(sourceWindow, source);
rule.setImageSize(1, 1);
transition.rule = rule;
// KAG passes tag attributes as strings; the script only fills 64 itself.
transition.vague = "64";
var mismatchedRule = false;
try {
    transitionDevice.startTransition(transition);
} catch (e) {
    mismatchedRule = true;
}
pluginAssertTrue("rule smaller than the device is explicit", mismatchedRule);
transitionDevice.capture(output, 0);
pluginAssertEqual("rejected universal preserves visible plane", 0x000000f0,
                  output.getMainPixel(0, 0));

rule.setImageSize(2, 2);
rule.fillRect(0, 0, 2, 2, 0xffffffff);
transitionDevice.startTransition(transition);
transitionDevice.transState = 0.5;
transitionDevice.capture(output, 0);
pluginAssertEqual("white rule pixel still shows the old frame at half time",
                  0x000000f0, output.getMainPixel(0, 0));
transitionDevice.transState = 0;
transitionDevice.capture(output, 0);
pluginAssertEqual("universal finishes on the front plane", 0x00f00000,
                  output.getMainPixel(0, 0));

rule.fillRect(0, 0, 2, 2, 0xff000000);
transitionDevice.startTransition(transition);
transitionDevice.transState = 1;
transitionDevice.capture(output, 0);
pluginAssertEqual("universal starts on the old frame", 0x00f00000,
                  output.getMainPixel(0, 0));
transitionDevice.transState = 0.5;
transitionDevice.capture(output, 0);
pluginAssertEqual("black rule pixel already shows the new frame at half time",
                  0x000000f0, output.getMainPixel(0, 0));
transitionDevice.transState = 0;
transitionDevice.capture(output, 0);
pluginAssertEqual("universal finishes on the back plane", 0x000000f0,
                  output.getMainPixel(0, 0));

// The alias must register the same nested-player dependency in a fresh process.
Scripts.execStorage("../drawdeviceD3D/emote_fixture.tjs");

pluginSmokePass("drawdeviceD3DZ.dll");
System.exit(0);
