// layerExSave.dll 插件 smoke test
// 用法：krkr2 <本目录>，脚本内 System.exit(0) 结束进程
Scripts.execStorage("../common/plugin_assert.tjs");
function check(cond, msg) {
    pluginAssertTrue(msg, cond);
}

// 在首次创建 Window/Layer 前加载，覆盖原生类惰性初始化场景。
Plugins.link("layerExSave.dll");

// 保存产物写到本目录（.gitignore 已忽略 *.tlg / *.png）
var outDir = Storages.extractStoragePath(Storages.getPlacedPath("startup.tjs"));

var testWindow = new Window();
var base = new Layer(testWindow, null);

function newLayer(w, h) {
    var l = new Layer(testWindow, base);
    l.setImageSize(w, h);
    return l;
}

// R/B 互不相同、alpha 各异的 4x2 图样；fillRect 取标准 0xAARRGGBB。
// 通道顺序写反时 R/B 互换，读回比较必然失败。
function makePattern() {
    var l = newLayer(4, 2);
    l.fillRect(0, 0, 1, 1, 0xFF102030);
    l.fillRect(1, 0, 1, 1, 0x80A0B0C0);
    l.fillRect(2, 0, 1, 1, 0xFF0000FF);
    l.fillRect(3, 0, 1, 1, 0xFFFF0000);
    l.fillRect(0, 1, 4, 1, 0xC0336699);
    return l;
}

function assertSamePixels(name, a, b) {
    pluginAssertEqual(name + " width", a.imageWidth, b.imageWidth);
    pluginAssertEqual(name + " height", a.imageHeight, b.imageHeight);
    for (var y = 0; y < a.imageHeight; y++)
        for (var x = 0; x < a.imageWidth; x++) {
            pluginAssertEqual(name + " rgb " + x + "," + y,
                              a.getMainPixel(x, y), b.getMainPixel(x, y));
            pluginAssertEqual(name + " alpha " + x + "," + y,
                              a.getMaskPixel(x, y), b.getMaskPixel(x, y));
        }
}

// 通道约定锚点：与上游 Windows 版一致，getAverageColor 返回
// B<<24|G<<16|R<<8|A（上游把字节 0..3 累加到 a/r/g/b）。
var anchor = newLayer(1, 1);
anchor.fillRect(0, 0, 1, 1, 0xFF102030);
pluginAssertEqual("getAverageColor upstream byte order", 0x302010FF,
                  anchor.getAverageColor(0, 0, 1, 1));

var src = makePattern();

// TLG5：插件编码，core 读取器解码
src.saveLayerImageTlg5(outDir + "layerexsave_smoke.tlg");
var tlg = newLayer(1, 1);
tlg.loadImages(outDir + "layerexsave_smoke.tlg");
assertSamePixels("tlg5 round trip", src, tlg);

// TLG5 + tags：写出 TLG0.0 sds 包装，core 仍能解码并取回标签
src.saveLayerImageTlg5(outDir + "layerexsave_smoke_tags.tlg", %[ yoghourt: "smoke" ]);
var tlgTags = newLayer(1, 1);
var meta = tlgTags.loadImages(outDir + "layerexsave_smoke_tags.tlg");
assertSamePixels("tlg5 tags round trip", src, tlgTags);
pluginAssertEqual("tlg5 tag value", "smoke", meta.yoghourt);

// PNG（LodePNG）：带 comp_lv 与 oFFs 标签
src.saveLayerImagePng(outDir + "layerexsave_smoke.png", %[ comp_lv: 9, offs_x: 3, offs_y: 4 ]);
var png = newLayer(1, 1);
png.loadImages(outDir + "layerexsave_smoke.png");
assertSamePixels("png round trip", src, png);

// PNG octet：两种参数形式都返回非空 octet
var oct = src.saveLayerImagePngOctet();
pluginAssertEqual("png octet type", "Octet", typeof oct);
check(oct.length > 8, "png octet has payload");
var octTags = src.saveLayerImagePngOctet(%[ comp_lv: 1 ]);
pluginAssertEqual("png octet (tags) type", "Octet", typeof octTags);

// Province：256 色调色板 PNG
var prov = newLayer(2, 2);
prov.setProvincePixel(1, 1, 3);
prov.saveProvinceImage(outDir + "layerexsave_smoke_province.png");
check(Storages.isExistentStorage(outDir + "layerexsave_smoke_province.png"),
      "province image written");

// getCropRect / getCropRectZero
var crop = newLayer(4, 4);
crop.fillRect(0, 0, 4, 4, 0x00000000);
check(crop.getCropRect() === void, "all transparent crop is void");
crop.fillRect(0, 3, 1, 1, 0x00FFFFFF); // 透明但非零
crop.fillRect(1, 2, 2, 1, 0xFF102030);
var r = crop.getCropRect();
pluginAssertEqual("crop x", 1, r.x);
pluginAssertEqual("crop y", 2, r.y);
pluginAssertEqual("crop w", 2, r.w);
pluginAssertEqual("crop h", 1, r.h);
var rz = crop.getCropRectZero();
pluginAssertEqual("crop zero x", 0, rz.x);
pluginAssertEqual("crop zero h", 2, rz.h);

// getDiffRect / getDiffPixel
var other = makePattern();
check(other.getDiffRect(src) === void, "identical images have no diff rect");
other.fillRect(2, 1, 1, 1, 0xFF123456);
var d = other.getDiffRect(src);
pluginAssertEqual("diff x", 2, d.x);
pluginAssertEqual("diff y", 1, d.y);
pluginAssertEqual("diff w", 1, d.w);
var ref = newLayer(1, 1);
ref.fillRect(0, 0, 1, 1, 0xFFAB0012);
pluginAssertEqual("diff pixel count", 1, other.getDiffPixel(src, void, 0xFFAB0012));
pluginAssertEqual("diffcol written as 0xAARRGGBB", ref.getMainPixel(0, 0),
                  other.getMainPixel(2, 1));

// fingerprint：同图同值，改一像素后变化
var fpA = makePattern(), fpB = makePattern();
pluginAssertEqual("fingerprint equal", fpA.getFingerPrintValue(), fpB.getFingerPrintValue());
fpB.fillRect(0, 0, 1, 1, 0xFF102031);
check(fpA.getFingerPrintValue() != fpB.getFingerPrintValue(), "fingerprint changes");

// shrink vector + Math.octetVectorSum
var va = fpA.getShrinkVectorOctet(2, 1);
pluginAssertEqual("shrink vector length", 2 * 1 * 4, va.length);
var sum = Math.octetVectorSum(va, fpA.getShrinkVectorOctet(2, 1));
pluginAssertEqual("vector self distance", 0, sum[1]);
pluginAssertEqual("vector self diff count", 0, sum[6]);

// copyBlueToAlpha：B 通道进入 alpha
var blueSrc = newLayer(1, 1);
blueSrc.fillRect(0, 0, 1, 1, 0xFF112280);
var alphaDst = newLayer(1, 1);
alphaDst.fillRect(0, 0, 1, 1, 0xFF000000);
alphaDst.copyBlueToAlpha(blueSrc);
pluginAssertEqual("copyBlueToAlpha", 0x80, alphaDst.getMaskPixel(0, 0));

// isBlank
var blank = newLayer(3, 3);
blank.fillRect(0, 0, 3, 3, 0x00000000);
blank.fillRect(2, 2, 1, 1, 0xFF0000FF);
check(blank.isBlank(0, 0, 2, 2), "isBlank empty region");
check(!blank.isBlank(1, 1, 5, 5), "isBlank clipped region sees blue pixel");

// clearAlpha：alpha <= 阈值的像素写成 0x00RRGGBB
var clr = newLayer(2, 1);
clr.fillRect(0, 0, 1, 1, 0x10A0B0C0);
clr.fillRect(1, 0, 1, 1, 0xFFA0B0C0);
clr.clearAlpha(0x20, 0x123456);
var clrRef = newLayer(1, 1);
clrRef.fillRect(0, 0, 1, 1, 0x00123456);
pluginAssertEqual("clearAlpha fill rgb", clrRef.getMainPixel(0, 0), clr.getMainPixel(0, 0));
pluginAssertEqual("clearAlpha fill alpha", 0, clr.getMaskPixel(0, 0));
pluginAssertEqual("clearAlpha keeps opaque", 255, clr.getMaskPixel(1, 0));

// oozeColor：不透明像素颜色扩散到相邻透明像素，alpha 不变
var ooze = newLayer(3, 1);
ooze.fillRect(0, 0, 3, 1, 0x00000000);
ooze.fillRect(0, 0, 1, 1, 0xFF102030);
ooze.oozeColor(1);
pluginAssertEqual("ooze spreads rgb", ooze.getMainPixel(0, 0), ooze.getMainPixel(1, 0));
pluginAssertEqual("ooze keeps alpha", 0, ooze.getMaskPixel(1, 0));
pluginAssertEqual("ooze one step only", 0, ooze.getMainPixel(2, 0));

// ---------------------------------------------------------------------------
// Window 异步保存（上游 Window.startSaveLayerImage 系列）
// ---------------------------------------------------------------------------
// worker 线程编码 → 窗口消息回传 → 主线程写文件这条链路要等帧循环排空投递
// 队列才会推进，所以这部分断言放在 AsyncTrigger 里；同步断言在 startup 阶段
// 已经全部跑完（失败会在到达这里之前抛异常结束）。
//
// TJS 的标识符解析是「当前コンテキストのプロパティ参照」で、クロージャ捕获は
// 効かない。ハンドラは具名グローバル関数、状態はグローバル変数に置く。

// 非同期テスト用の大きめの図柄：キャンセルが worker の完了に負けないよう、
// 数フレーム分のエンコード時間がかかるサイズにする（4x2 では一瞬で完了する）。
var asyncSrc = newLayer(1024, 1024);
asyncSrc.fillRect(0, 0, 1024, 1024, 0xFF204060);
asyncSrc.fillRect(0, 0, 1024, 8, 0xFF8080FF);
asyncSrc.fillRect(512, 0, 8, 1024, 0x40FF4040);

var asyncState = %[
    phase: 1,
    cancelOnProgress: false,
    cancelSent: false,
    started: 0,
    progressCount: 0,
    lastProgress: -1,
    progressMonotonic: true,
    doneCount: 0,
    doneCanceled: -1,
    frames: 0
];

// 共通ハンドラ
function asyncProgressEvent(handler, progress, layer, filename) {
    asyncState.progressCount += 1;
    if (progress < asyncState.lastProgress)
        asyncState.progressMonotonic = false;
    asyncState.lastProgress = progress;
    // 最初の進捗が届いた時点で worker は必ずまだ走っている（進捗を投げて
    // から次のブロックへ進む）ので、ここでキャンセルすればレースにならない。
    if (asyncState.cancelOnProgress && !asyncState.cancelSent) {
        asyncState.cancelSent = true;
        testWindow.cancelSaveLayerImage(handler);
    }
}

function asyncDoneEvent(handler, canceled, layer, filename) {
    asyncState.doneCount += 1;
    asyncState.doneCanceled = canceled;
}

// ウィンドウのイベントハンドラ（上游 manual.tjs の
// onSaveLayerImageProgress / onSaveLayerImageDone）
testWindow.onSaveLayerImageProgress = asyncProgressEvent;
testWindow.onSaveLayerImageDone = asyncDoneEvent;

var asyncTrigger = new AsyncTrigger(testWindow);

function asyncCheck(cond, msg) {
    if (!cond) {
        Debug.message("PLUGIN_ASSERT_FAIL name=" + msg +
            " expected=true actual=false");
        throw new Exception("plugin assertion failed: " + msg);
    }
}

function asyncResetProgress() {
    asyncState.progressCount = 0;
    asyncState.lastProgress = -1;
    asyncState.progressMonotonic = true;
    asyncState.frames = 0;
}

function asyncStep() {
    asyncState.frames += 1;
    if (asyncState.frames > 600) {
        asyncCheck(false, "asynchronous save advanced before timeout (phase " +
            asyncState.phase + ")");
    }

    if (asyncState.phase == 1) {
        if (asyncState.doneCount == 0) {
            asyncTrigger.trigger();
            return;
        }
        // 正常系：進捗は複数回・単調で 100 に達し、完了は canceled=0
        asyncCheck(asyncState.started >= 0, "start returns a handler");
        asyncCheck(asyncState.progressCount > 0, "progress event fired");
        asyncCheck(asyncState.progressMonotonic, "progress is monotonic");
        asyncCheck(asyncState.lastProgress == 100, "progress reaches 100");
        asyncCheck(asyncState.doneCanceled == 0, "done reports not canceled");
        // 非同期産物は同期産物と画素一致（同一エンコーダ経路の検証）。
        // asyncSrc を同期 API で書いたものと読み比べる。
        var syncRef = newLayer(1, 1);
        var syncFile = outDir + "layerexsave_async_sync_ref.tlg";
        asyncSrc.saveLayerImageTlg5(syncFile);
        syncRef.loadImages(syncFile);
        var asyncLayer = newLayer(1, 1);
        asyncLayer.loadImages(outDir + "layerexsave_async.tlg");
        assertSamePixels("async tlg5 matches sync output", syncRef, asyncLayer);

        // phase 2：進捗でキャンセル
        asyncState.started = testWindow.startSaveLayerImage(
            asyncSrc, outDir + "layerexsave_async_cancel.tlg");
        asyncState.doneCount = 0;
        asyncState.doneCanceled = -1;
        asyncState.cancelOnProgress = true;
        asyncState.cancelSent = false;
        asyncResetProgress();
        asyncState.phase = 2;
        asyncTrigger.trigger();
        return;
    }

    if (asyncState.phase == 2) {
        if (asyncState.doneCount == 0) {
            asyncTrigger.trigger();
            return;
        }
        asyncCheck(asyncState.cancelSent, "cancel was delivered mid-encode");
        asyncCheck(asyncState.doneCanceled == 1, "cancel reports canceled=1");
        asyncCheck(!Storages.isExistentStorage(
                        outDir + "layerexsave_async_cancel.tlg"),
                    "canceled save writes no file");

        // phase 3：stop は完了イベントを出さない
        asyncState.started = testWindow.startSaveLayerImage(
            asyncSrc, outDir + "layerexsave_async_stop.tlg");
        testWindow.stopSaveLayerImage(asyncState.started);
        asyncState.doneCount = 0;
        asyncResetProgress();
        asyncState.phase = 3;
        asyncTrigger.trigger();
        return;
    }

    // phase 3：数フレーム待っても完了イベントが来ないことを確認する
    if (asyncState.frames < 60) {
        asyncTrigger.trigger();
        return;
    }
    // 上游の stop は「スロットを外して完了イベントを出さない」だけで、既に
    // 走っている worker を止めはしない（ファイルの書き込み可否は実装依存）。
    // ここで主張するのは通知契約だけ。
    asyncCheck(asyncState.doneCount == 0, "stopped save fires no done");

    pluginSmokePass("layerExSave.dll");
    System.exit(0);
}

asyncTrigger.onFire = asyncStep;
asyncState.started = testWindow.startSaveLayerImage(
    asyncSrc, outDir + "layerexsave_async.tlg");
asyncTrigger.trigger();
