Scripts.execStorage("../common/plugin_assert.tjs");
function check(condition, message) { pluginAssertTrue(message, condition); }

Plugins.link("extNagano.dll");
Plugins.link("EXTNAGANO.DLL");

class PluginSmokeWindow extends Window {
    function PluginSmokeWindow() { super.Window(); }
    function onTransitionCompleted(dest, src) { handleTransitionCompleted(dest, src); }
    function onSmokeTimer() { observeProgress(); }
}
var testWindow = new PluginSmokeWindow();
var primary = new Layer(testWindow, null);
var destination = new Layer(testWindow, primary);
var source = new Layer(testWindow, primary);
var rule = new Layer(testWindow, primary);
testWindow.setInnerSize(32, 32);
primary.setImageSize(32, 32);
source.setImageSize(32, 32);
destination.setImageSize(32, 32);
rule.setImageSize(32, 32);
primary.visible = true;
destination.visible = true;
source.visible = false;
rule.visible = false;
testWindow.visible = true;

for (var y = 0; y < 32; y++) {
    for (var x = 0; x < 32; x++) {
        destination.setMainPixel(x, y, 0xff000000 | (x << 8) | y);
        source.setMainPixel(x, y, 0xff000000 | (y << 16) | x);
        var alpha = (x > 16) ? 0xff : 0x00;
        rule.setMainPixel(x, y, (alpha << 24) | (x << 16) | (y << 8) | 64);
    }
}

var missingTime = null;
try {
    destination.beginTransition("scanline", false, source, %[]);
} catch (e) {
    missingTime = e;
}
check(missingTime != null, "missing time is rejected");

var missingRule = null;
try {
    destination.beginTransition("imagewipe", false, source, %[time: 80]);
} catch (e) {
    missingRule = e;
}
check(missingRule != null, "imagewipe without rule is rejected");

var missing3d = null;
try {
    destination.beginTransition("3duniversal", false, source, %[time: 80]);
} catch (e) {
    missing3d = e;
}
check(missing3d != null, "3duniversal without rule is rejected");

var sizeMismatch = null;
var other = new Layer(testWindow, source);
other.setImageSize(16, 16);
try {
    destination.beginTransition("rgbfade", false, other, %[time: 80]);
} catch (e) {
    sizeMismatch = e;
}
check(sizeMismatch != null, "mismatched layer size is rejected");

var effects = [
    ["blurfade", %[time: 80, blur1: 2, blur2: 2]],
    ["zoomfade", %[time: 80, zoom1: 150, zoom2: 80]],
    ["rgbfade", %[time: 80, delayR: 40, delayG: 20, delayB: 0, delayA: 0]],
    ["spin", %[time: 80, type1: 0, type2: 1]],
    ["flutter", %[time: 80, back: 0x80102030, alpha: 200, slip: 4]],
    ["book", %[time: 80, dir: 0]],
    ["imagewipe", %[time: 80, rule: rule, dir: 0]],
    ["honeyturn", %[time: 80, size: 8, dir: 6, order: 6, twist: 1]],
    ["morphing", %[
        time: 80,
        before: [0, 0, 31, 0, 0, 31, 31, 0, 31, 31, 0, 31],
        after:  [2, 1, 29, 2, 1, 30, 30, 1, 29, 30, 2, 29]
    ]],
    ["multiripple", %[
        time: 80,
        count: 2,
        wavecount: 2,
        rwidth: 8,
        maxdrift: 2,
        roundness: 1.0,
        delaylast: 1.0
    ]],
    ["3duniversal", %[
        time: 80,
        rule: rule,
        type: "RGB",
        speed1: 2,
        accel1: 0,
        bound1: 0,
        speed2: 1,
        accel2: 0,
        bound2: 0
    ]]
];
var effectIndex = 0;
var activeEffect = "scanline";
var progressed = false;
var completed = 0;
var transitionStarted = false;
var transitionTick = 0;
var transitionClock = function() {
    if (transitionTick > 0) sampleProgress();
    transitionTick += 20;
    return transitionTick;
};
var samplePoints = [[0, 0], [7, 11], [16, 16], [23, 5], [31, 31]];
var initialSamples = [];

function captureInitialSamples() {
    initialSamples = [];
    for (var i = 0; i < samplePoints.count; i++)
        initialSamples.add(destination.getMainPixel(
            samplePoints[i][0], samplePoints[i][1]));
}

function sampleProgress() {
    if (progressed) return;
    for (var i = 0; i < samplePoints.count; i++) {
        var x = samplePoints[i][0];
        var y = samplePoints[i][1];
        if (destination.getMainPixel(x, y) != initialSamples[i]) {
            progressed = true;
            return;
        }
    }
}

function resetImages() {
    for (var py = 0; py < 32; py++) {
        for (var px = 0; px < 32; px++) {
            destination.setMainPixel(px, py, 0xff000000 | (px << 8) | py);
            source.setMainPixel(px, py, 0xff000000 | (py << 16) | px);
        }
    }
}

function beginNextEffect() {
    if (effectIndex >= effects.count) {
        check(completed == effects.count + 1, "every transition completed naturally");
        smokeTimer.enabled = false;
        pluginSmokePass("extNagano.dll");
        testWindow.visible = false;
        System.exit(0);
        return;
    }
    resetImages();
    activeEffect = effects[effectIndex][0];
    progressed = false;
    transitionTick = 0;
    captureInitialSamples();
    effects[effectIndex][1].callback = transitionClock;
    destination.beginTransition(activeEffect, false, source,
        effects[effectIndex][1]);
    effectIndex++;
}

var handleTransitionCompleted = function(dest, src) {
    // Mid-transition Process() writes the handler dest buffer. Layer
    // getMainPixel still sees the pre-transition MainImage, so a 5-point
    // sample can stay unchanged until MakeFinalImage. The observable
    // contract is the completed exchange.
    for (var fy = 0; fy < 32; fy++)
        for (var fx = 0; fx < 32; fx++)
            pluginAssertEqual(activeEffect + " final pixel " + fx + "," + fy,
                source.getMainPixel(fx, fy),
                destination.getMainPixel(fx, fy));
    completed++;
    beginNextEffect();
};
destination.onTransitionCompleted = function(dest, src) {
    handleTransitionCompleted(dest, src);
};

var observeProgress = function() {
    if (!transitionStarted) {
        transitionStarted = true;
        captureInitialSamples();
        destination.beginTransition("scanline", false, source,
            %[time: 80, callback: transitionClock]);
        return;
    }
    sampleProgress();
};
var smokeTimer = new Timer(testWindow, "onSmokeTimer");
smokeTimer.interval = 10;
smokeTimer.enabled = true;
