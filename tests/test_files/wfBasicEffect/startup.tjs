Scripts.execStorage("../common/plugin_assert.tjs");
Plugins.link("wfBasicEffect.dll");
Plugins.link("wfBasicEffect.dll");
Plugins.link("wfTypicalDSP.dll");
var delay = new WaveSoundBuffer.DelayEffect(80, 0.5, 0.6, 150);
delay.init(80, 0.5, 0.6);
pluginAssertTrue("delay interface", delay.interface != 0);
var verb = new WaveSoundBuffer.StkFreeVerb();
pluginAssertEqual("mix default", 0.75, verb.effectMix);
pluginAssertEqual("room default", 0.75, verb.roomSize);
pluginAssertEqual("damping default", 0.25, verb.damping);
pluginAssertEqual("width default", 1, verb.width);
pluginAssertEqual("extend default", 1000, verb.extend);
pluginAssertTrue("mode default", !verb.mode);
verb.effectMix = 0.5;
verb.roomSize = 0.7;
verb.damping = 0.3;
verb.width = 0.8;
verb.mode = false;
verb.extend = 150;
var low = new WaveSoundBuffer.WaveDSPFilter("LowPass", "Butterworth");
low.setParams(void, 2, 1080);
var sound = new WaveSoundBuffer(null);
sound.filters.add(low);
sound.filters.add(delay);
sound.filters.add(verb);
sound.open("../wuvorbis/test.ogg");
sound.play();
sound.stop();
sound.open("../wuvorbis/test.ogg");
sound.play();
sound.stop();
invalidate sound;
var next = new WaveSoundBuffer(null);
next.filters.add(delay);
next.filters.add(verb);
next.open("../wuvorbis/test.ogg");
delay = void;
verb = void;
next.filters.clear();
next.play();
next.stop();
invalidate next;
pluginSmokePass("wfBasicEffect.dll");
System.exit(0);
