// shrinkCopy.dll 插件 smoke test
// 用法：krkr2 <本目录>，脚本内 System.exit(0) 结束进程
Scripts.execStorage("../common/plugin_assert.tjs");
function check(cond, msg) {
    pluginAssertTrue(msg, cond);
}

// 在首次创建 Window/Layer 前加载，覆盖原生类惰性初始化场景。
// Plugins.link 的原生 API 返回 void，加载结果由导出的成员确认。
Plugins.link("shrinkCopy.dll");

// 真实调用：8x8 纯色源 → 4x4 目标
var testWindow = new Window();
var src = new Layer(testWindow, null);
src.setImageSize(8, 8);
src.fillRect(0, 0, 8, 8, 0xFF7F3F1F);
check(src.hasImage, "src hasImage");

var dst = new Layer(testWindow, src);
dst.setImageSize(4, 4);
dst.shrinkCopy(0, 0, 4, 4, src, 0, 0, 8, 8);
check(dst.hasImage, "dst hasImage after shrinkCopy");
check(dst.imageWidth == 4 && dst.imageHeight == 4, "dst size preserved");

// 放大必须报错（仅缩小）
// 缩小 3 倍：目标尺寸按 ceil 改写
var dst2 = new Layer(testWindow, src);
dst2.setImageSize(1, 1);
dst2.shrinkCopyFast(src, 3, 3);
check(dst2.imageWidth == 3 && dst2.imageHeight == 3, "shrinkCopyFast resized to ceil(8/3)");

pluginSmokePass("shrinkCopy.dll");
System.exit(0);
